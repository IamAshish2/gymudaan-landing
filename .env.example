# Backend REST API (must follow the contract in docs/API.md). Server-only — never
# exposed to the browser.
API_BASE_URL=http://localhost:8080/api/v1

# Public site origin (origin only, no path). Source of every canonical, og:url,
# sitemap and robots URL (lib/seo/site-url.ts). REQUIRED for `next build`: a
# production build fails without it. Only `next dev` falls back to localhost.
# Production: https://www.gymudaan.com. Local `next build && next start`:
# http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://www.gymudaan.com

# Which deployment this build is for: production | staging | preview |
# development (lib/seo/site-env.ts). REQUIRED for `next build`, which fails if
# it is missing or invalid; `next dev` defaults to development. Only production
# builds can be indexed. Every other value sends `X-Robots-Tag: noindex,
# nofollow`, a robots `noindex` meta tag and an empty sitemap.
#   production: NEXT_PUBLIC_SITE_URL must be https://www.gymudaan.com, and the
#     host must agree where it says (Vercel VERCEL_ENV, Netlify CONTEXT,
#     Cloudflare Pages CF_PAGES_BRANCH = SITE_PRODUCTION_BRANCH).
#   staging / preview / development: must NOT use https://www.gymudaan.com.
# SITE_ENV=production
# Cloudflare Pages only: the branch that deploys production.
# SITE_PRODUCTION_BRANCH=main

# GA4 measurement ID (components/shared/Analytics.tsx). Loaded only by
# production builds; unset means no analytics. The live site uses
# G-MRY1JZCLXM: set it here only once the owner confirms that is the property
# to keep (measurement continuity, docs/seo/08 §12). An invalid value fails the build.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
