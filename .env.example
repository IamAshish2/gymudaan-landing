# Backend REST API (must follow the contract in docs/API.md). Server-only — never
# exposed to the browser.
API_BASE_URL=http://localhost:8080/api/v1

# Public site origin (origin only, no path). Source of every canonical, og:url,
# sitemap and robots URL (lib/seo/site-url.ts). REQUIRED for `next build`: a
# production build fails without it. Only `next dev` falls back to localhost.
# Production: https://www.gymudaan.com. Local `next build && next start`:
# http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://www.gymudaan.com
